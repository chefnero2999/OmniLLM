<?xml version="1.0" encoding="utf-8"?>
<!--
  Models are gigabytes and are re-downloadable; backing them up would blow the user's
  cloud quota. Only settings are eligible for backup, and cloud transfer is disabled
  because prompts never leave the device in local mode.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="models" />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
